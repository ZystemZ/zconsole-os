#!/bin/bash
# ZConsole OS - launcher Big Picture com readiness e fallback seguro.
set -u

URL="${ZCONSOLE_STORE_URL:-http://127.0.0.1:48521}"
API_STATUS_URL="$URL/api/status"
LEGACY="/usr/bin/zgamestore-gui-legacy"
LOG="${XDG_CACHE_HOME:-/tmp}/zconsole-gamestore.log"

fallback() {
    echo "[Z-GameStore] Usando interface legada: $*" >>"$LOG"
    exec /usr/bin/python3 "$LEGACY"
}

# Sem sessão gráfica, não tentar abrir Chromium e evitar uma tela preta.
if [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ]; then
    fallback "DISPLAY/WAYLAND_DISPLAY ausente"
fi

systemctl start --no-block zconsole-local-api.service >/dev/null 2>&1 || \
    (python3 /usr/lib/zconsole/zconsole_local_api.py >>"$LOG" 2>&1 &)

READY=0
for _ in {1..30}; do
    if command -v curl >/dev/null 2>&1; then
        index_html="$(curl --connect-timeout 1 --max-time 2 -fsS "$URL/" 2>/dev/null || true)"
        asset_path="$(printf '%s' "$index_html" | grep -oE 'assets/[^" ]+\.js' | head -n 1 || true)"
        if curl --connect-timeout 1 --max-time 2 -fsS "$API_STATUS_URL" >/dev/null 2>&1 \
            && [ -n "$asset_path" ] \
            && curl --connect-timeout 1 --max-time 2 -fsS "$URL/$asset_path" >/dev/null 2>&1; then
            READY=1
            break
        fi
    fi
    sleep 0.5
done

[ "$READY" -eq 1 ] || fallback "serviço local não ficou pronto"

for browser in chromium chromium-browser google-chrome; do
    if command -v "$browser" >/dev/null 2>&1; then
        profile_dir="${XDG_RUNTIME_DIR:-/tmp}/zconsole-chromium-${UID:-0}"
        mkdir -p "$profile_dir"
        echo "[Z-GameStore] Abrindo $browser em $URL" >>"$LOG"
        "$browser" \
            --kiosk \
            --app="$URL" \
            --user-data-dir="$profile_dir" \
            --no-first-run \
            --no-default-browser-check \
            --noerrdialogs \
            --disable-session-crashed-bubble \
            --disable-pinch \
            --overscroll-history-navigation=0 \
            --disable-features=TranslateUI \
            --disable-gpu \
            --disable-gpu-compositing \
            --disable-dev-shm-usage \
            --start-maximized >>"$LOG" 2>&1 &
        browser_pid=$!
        wait "$browser_pid"
        exit_code=$?
        echo "[Z-GameStore] Chromium encerrou com código $exit_code; fallback Tkinter." >>"$LOG"
        fallback "Chromium encerrou"
    fi
done

fallback "navegador Chromium não encontrado"
