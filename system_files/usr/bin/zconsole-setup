#!/usr/bin/env bash
# ZConsole OS — configuração inicial do usuário.
set -u

log() { printf '[ZConsole Setup] %s\n' "$*"; }

log 'Criando estrutura de pastas para ROMs e saves...'
mkdir -p "$HOME/Emulation"/roms/{dos,pc,snes,megadrive,nes,n64,psx,amiga,arcade,wiiu,switch,3ds,psvita}
mkdir -p "$HOME/Emulation/saves" "$HOME/Emulation/tools/downloaded_media"

if command -v emudeck >/dev/null 2>&1; then
    log 'EmuDeck já está instalado.'
else
    log 'EmuDeck não detectado. Instale-o pela Z-GameStore quando houver rede.'
fi

if [ -x /usr/bin/zgamestore ]; then
    log 'Z-GameStore pronta para downloads autorizados.'
else
    log 'Aviso: /usr/bin/zgamestore não está disponível nesta imagem.'
fi

if [ -d "$HOME/.steam/steam" ]; then
    log 'Steam detectada; o atalho pode ser adicionado pelas configurações da interface.'
fi

log 'ZConsole OS pronto para configurar.'
