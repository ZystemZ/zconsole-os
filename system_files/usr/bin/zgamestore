#!/usr/bin/env python3
"""
ZConsole OS - Smart Z-GameStore
Automated downloader and organizer for Free & Abandonware games.
Integrates with EmuDeck folder structure.
"""

import os
import sys
import json
import zipfile
import shutil
import subprocess
import urllib.request
import argparse
from pathlib import Path

# Configuration
CATALOG_PATH = os.environ.get("ZCONSOLE_CATALOG_PATH", "/etc/zconsole/games_catalog.json")
BASE_ROM_DIR = Path(os.path.expanduser(os.environ.get("ZCONSOLE_ROM_DIR", "~/Emulation/roms")))
MEDIA_DIR = Path(os.path.expanduser(os.environ.get("ZCONSOLE_MEDIA_DIR", "~/Emulation/tools/downloaded_media")))

# Mapping platforms to EmuDeck folders
PLATFORM_MAP = {
    "dos": "dos",
    "windows": "pc",
    "snes": "snes",
    "megadrive": "megadrive",
    "genesis": "megadrive",
    "nes": "nes",
    "ps1": "psx",
    "n64": "n64",
    "amiga": "amiga",
    "arcade": "arcade"
}

def load_catalog():
    if os.path.exists(CATALOG_PATH):
        with open(CATALOG_PATH, "r") as f:
            return json.load(f)
    return {"games": []}

def list_games(platform=None):
    catalog = load_catalog()
    print("\n" + "="*50)
    print("  Z-GAMESTORE: CATALOGO DE JOGOS GRATUITOS")
    print("="*50)
    
    for game in catalog["games"]:
        if platform and game["platform"].lower() != platform.lower():
            continue
        print(f"ID: {game['id']}")
        print(f"Nome: {game['title']}")
        print(f"Plataforma: {game['platform'].upper()}")
        print(f"Desc: {game['description'][:80]}...")
        print("-" * 30)

def open_source(url):
    """Open a catalog source without pretending that a web page is a ROM archive."""
    for opener in (("xdg-open", url), ("gio", "open", url)):
        if shutil.which(opener[0]):
            try:
                subprocess.Popen(opener, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                return True
            except OSError:
                continue
    return False


def download_archive(url, destination):
    request = urllib.request.Request(url, headers={"User-Agent": "ZConsole-GameStore/2.0"})
    with urllib.request.urlopen(request, timeout=60) as response:
        signature = response.read(4)
        if not signature.startswith(b"PK"):
            raise ValueError("a fonte retornou uma página, não um arquivo ZIP baixável")
        with destination.open("wb") as output:
            output.write(signature)
            shutil.copyfileobj(response, output)
    if not zipfile.is_zipfile(destination):
        destination.unlink(missing_ok=True)
        raise ValueError("o arquivo baixado não é um ZIP válido")


def install_game(game_id):
    catalog = load_catalog()
    game = next((g for g in catalog["games"] if g["id"] == game_id), None)
    
    if not game:
        print(f"[Erro] Jogo '{game_id}' não encontrado no catálogo.")
        return 1

    # 1. Determine Paths
    platform_folder = PLATFORM_MAP.get(game["platform"].lower(), game["platform"].lower())
    target_dir = BASE_ROM_DIR / platform_folder / game["id"]
    temp_zip = Path(f"/tmp/{game['id']}.zip")
    
    print(f"\n[Z-GameStore] Iniciando instalação de: {game['title']}")
    print(f"[Z-GameStore] Plataforma detectada: {game['platform'].upper()}")
    
    # 2. Open a source page or download a verified archive.
    source_url = game.get("download_url") or game.get("source_url")
    if not source_url:
        print("[Erro] Este item não possui uma fonte de download cadastrada.")
        return 1
    try:
        print("[Z-GameStore] Verificando fonte de download...")
        source_path = source_url.lower().split("?", 1)[0]
        if not source_path.endswith(".zip"):
            if open_source(source_url):
                print("[Info] A fonte foi aberta no navegador. O download deve ser iniciado na página oficial.")
                return 0
            print(f"[Erro] Nenhum abridor gráfico disponível. Abra manualmente a fonte oficial: {source_url}")
            return 1
        print("[Z-GameStore] Baixando arquivo compactado...")
        download_archive(source_url, temp_zip)
    except Exception as e:
        print(f"[Erro] Falha no download: {e}")
        return 1

    # 3. Extract and Organize
    try:
        print(f"[Z-GameStore] Extraindo e organizando em {target_dir}...")
        os.makedirs(target_dir, exist_ok=True)
        with zipfile.ZipFile(temp_zip, "r") as zip_ref:
            unsafe = [name for name in zip_ref.namelist() if Path(name).is_absolute() or ".." in Path(name).parts]
            if unsafe:
                raise ValueError("arquivo compactado contém caminhos inseguros")
            zip_ref.extractall(target_dir)
        temp_zip.unlink(missing_ok=True)
    except Exception as e:
        print(f"[Erro] Falha na extração: {e}")
        return 1

    # 4. Download Media (Box Art)
    if "image_url" in game:
        try:
            print(f"[Z-GameStore] Baixando capa do jogo...")
            media_path = MEDIA_DIR / platform_folder / f"{game['id']}.png"
            os.makedirs(media_path.parent, exist_ok=True)
            urllib.request.urlretrieve(game["image_url"], media_path)
        except:
            print("[Aviso] Não foi possível baixar a capa, mas o jogo foi instalado.")

    # 5. Post-Install Config (e.g. DOSBox)
    if game["platform"].lower() == "dos":
        create_dos_launcher(target_dir, game)

    print(f"\n[Sucesso] {game['title']} instalado e pronto para jogar!")
    print(f"Local: {target_dir}")
    return 0

def create_dos_launcher(game_dir, game):
    # Create a simple .sh or .conf to help EmuDeck/RetroArch
    launcher = game_dir / "start.sh"
    with open(launcher, "w") as f:
        f.write("#!/bin/bash\n")
        f.write(f"# Launcher para {game['title']}\n")
        f.write("dosbox ./\n")
    os.chmod(launcher, 0o755)

def main():
    parser = argparse.ArgumentParser(description="ZConsole OS - Smart Z-GameStore")
    subparsers = parser.add_subparsers(dest="command")

    # List command
    list_parser = subparsers.add_parser("list", help="Listar jogos disponíveis")
    list_parser.add_argument("--platform", help="Filtrar por plataforma (dos, pc, snes, etc.)")

    # Get command
    get_parser = subparsers.add_parser("get", help="Baixar e instalar um jogo")
    get_parser.add_argument("id", help="ID do jogo para instalar")

    args = parser.parse_args()

    if args.command == "list":
        list_games(args.platform)
        return 0
    if args.command == "get":
        return install_game(args.id)
    parser.print_help()
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
